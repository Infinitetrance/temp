# --- CONFIGURATION ---
# The name of the file containing your repository URLs.
$repoListFile = "repos.txt"
# The name of the final output file that will contain all logs.
$outputFile = "combined_git_logs.txt"
# The name of the temporary directory for cloning. It will be created and deleted automatically.
$tempCloneDir = "temp_repo"


# --- SCRIPT START ---
Write-Host "🚀 Starting git log collection..." -ForegroundColor Green

# Clear the output file from previous runs to start fresh.
if (Test-Path $outputFile) {
    Clear-Content $outputFile
}

# Check if the list of repos exists.
if (-not (Test-Path $repoListFile)) {
    Write-Host "❌ Error: The file '$repoListFile' was not found. Please create it and add your repo URLs." -ForegroundColor Red
    # Pause the script to show the error message before closing.
    Read-Host "Press Enter to exit"
    exit
}

# Read each repository URL from the file.
Get-Content $repoListFile | ForEach-Object {
    # The current URL from the file.
    $repoUrl = $_.Trim()

    # Skip any blank lines in the input file.
    if ([string]::IsNullOrWhiteSpace($repoUrl)) {
        return
    }

    try {
        # Extract a clean repository name from the URL.
        # It takes the last part of the URL and removes the '.git' suffix.
        $repoName = ($repoUrl.Split('/')[-1]).Replace('.git', '')

        Write-Host "Processing repository: $repoName" -ForegroundColor Yellow

        # Clean up the temporary directory from a previous run, just in case.
        if (Test-Path $tempCloneDir) {
            Remove-Item -Recurse -Force $tempCloneDir
        }

        # Clone the repository. Using --bare is faster as it doesn't check out the files.
        git clone --bare $repoUrl $tempCloneDir | Out-Null

        # Run the git log command. We use --git-dir to point to our bare clone.
        # The output is captured into a variable.
        $logOutput = & git --git-dir=$tempCloneDir log --all --decorate --oneline --graph --pretty=format:"%h %an %ad %s"

        # Process each line of the log output.
        $prefixedOutput = $logOutput | ForEach-Object {
            # Add the repository name as a prefix to each line.
            "$repoName: $_"
        }

        # Append the prefixed log lines to our main output file.
        $prefixedOutput | Add-Content -Path $outputFile

    } catch {
        # Handle any errors during clone or log extraction.
        Write-Host "❌ Failed to process '$repoUrl'. Error: $($_.Exception.Message)" -ForegroundColor Red
    } finally {
        # IMPORTANT: Clean up by deleting the temporary repo directory.
        if (Test-Path $tempCloneDir) {
            Remove-Item -Recurse -Force $tempCloneDir
        }
    }
}

Write-Host "✅ All done! Logs have been saved to '$outputFile'." -ForegroundColor Green
Read-Host "Press Enter to exit"
